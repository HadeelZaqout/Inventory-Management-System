<Window x:Class="Inventory_Managment_System.Views.AddInvoiceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Inventory_Managment_System.Views"
        mc:Ignorable="d"
        Title="Add Invoice " Height="450" Width="800">
    <Grid Margin="15">

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- ROW 01 : SUPPLIER -->
        <!-- ================================================= -->
        <Border Grid.Row="0"
            Padding="15"
            Margin="0,0,0,10"
            BorderBrush="#D9D9D9"
            BorderThickness="1"
            CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Labels -->

                <TextBlock Text="Customer"
                    FontWeight="SemiBold"
                    Margin="0,0,10,5"
                    VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                   Text="Phone"
                   FontWeight="SemiBold"    
                   Margin="0,0,10,5"/>

                <TextBlock Grid.Column="2"
                   Text="Address"
                   FontWeight="SemiBold"
                   Margin="0,0,10,5"/>

                <!-- Controls -->

                <ComboBox 
                      Grid.Row="1"
                      Height="35"
                      FontSize="14"
                      ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer}"
                      Text="{Binding CustomerName , UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True"
                      StaysOpenOnEdit="True"
                      IsTextSearchEnabled="True"
                      DisplayMemberPath="CustomerName" Margin="0,0,10,0"/>

                <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Height="35"
                     Margin="0,0,10,0"
                     GotFocus="TextBox_GotFocus"
                     LostFocus="TextBox_LostFocus"
                     Text="{Binding PhoneNumber , UpdateSourceTrigger=PropertyChanged}" />

                <TextBox Grid.Row="1"
                     Grid.Column="2"
                     Height="35"
                     Margin="0,0,10,0"
                     GotFocus="TextBox_GotFocus"
                     LostFocus="TextBox_LostFocus"
                     Text="{Binding Address , UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Add Button -->
            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- ROW 02 : ITEM ENTRY -->
        <!-- ================================================= -->

        <Border Grid.Row="1"
            Padding="15"
            Margin="0,0,0,10"
            BorderBrush="#D9D9D9"
            BorderThickness="1"
            CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Labels -->

                <TextBlock Text="Item"
                       FontWeight="SemiBold"
                       Margin="0,0,10,5"/>

                <TextBlock Grid.Column="1"
                       Text="Quantity"
                       FontWeight="SemiBold"
                       Margin="0,0,10,5"/>
                <TextBlock Grid.Column="1"
                       Width="50"
                       Text ="{Binding MeasuringUnitText}"
                       FontWeight="SemiBold"
                       Margin="0,0,10,5"/>

                <TextBlock Grid.Column="2"
                       Text="Sale Price"
                       FontWeight="SemiBold"
                       Margin="0,0,10,5"/>

                <!-- Controls -->

                <ComboBox Grid.Row="1"
                      Height="35"
                      Margin="0,0,10,0"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem , UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True"
                      StaysOpenOnEdit="True"
                      IsTextSearchEnabled="True"
                      DisplayMemberPath="Name"/>

                <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Height="35"
                     Margin="0,0,10,0"
                     GotFocus="TextBox_GotFocus"
                     LostFocus="TextBox_LostFocus"
                     Text="{Binding Quantity , UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Grid.Row="1"
                     Grid.Column="2"
                     Height="35"
                     Margin="0,0,10,0"
                     Text="{Binding PurchasePrice , UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Add Button -->

                <Button Grid.Row="1"
                    Grid.Column="3"
                    Width="100"
                    Height="35"
                    Content="Add Item"
                    Command="{Binding AddInvoiceItemCommand}"/>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- ROW 03 : DATAGRID -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
            Padding="10"
            Margin="0,0,0,10"
            BorderBrush="#D9D9D9"
            BorderThickness="1"
            CornerRadius="8">

            <DataGrid ItemsSource="{Binding InvoiceItems}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  FontSize="14">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Item Name"
                                    Width="*"
                                    Binding="{Binding Item.Name}"/>

                    <DataGridTextColumn Header="Quantity"
                                    Width="150"
                                    Binding="{Binding Quantity}"/>

                    <DataGridTextColumn Header="Purchase Price"
                                    Width="150"
                                    Binding="{Binding SalePrice}"/>



                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- ================================================= -->
        <!-- ROW 04 : TOTAL + SAVE -->
        <!-- ================================================= -->

        <Border Grid.Row="3"
            Padding="15"
            BorderBrush="#D9D9D9"
            BorderThickness="1"
            CornerRadius="8">

            <Grid Margin="0,0,-6,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                   Text="Discount :"
                   FontSize="16"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="-6,0,255,0"/>

                <TextBox Grid.Column="0"
                         GotFocus="TextBox_GotFocus"
                         LostFocus="TextBox_LostFocus"
                     IsReadOnly="False"
                     FontSize="15"
                         
                     FontWeight="SemiBold"
                     Text="{Binding Discount}" Margin="72,0,292,0"/>
                <TextBlock
                       Text="Extra Charges  :"
                       FontSize="16"
                       Width="120"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="176,0,167,0"/>

                <TextBox
                    GotFocus="TextBox_GotFocus"
                     LostFocus="TextBox_LostFocus"
                             IsReadOnly="False"
                             FontSize="15"
                             FontWeight="SemiBold"

                             Text="{Binding ExtraCharges}" Margin="300,0,80,0" RenderTransformOrigin="0.5,0.5">
                    <TextBox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TextBox.RenderTransform>
                </TextBox>

                <TextBlock
                                           Text="Paid :"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="388,0,26,0" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBox
                 IsReadOnly="False"
                 FontSize="15"
                 FontWeight="SemiBold"
                    GotFocus="TextBox_GotFocus"
                   LostFocus="TextBox_LostFocus"
                 Text="{Binding Paid}" Margin="442,0,143,0" RenderTransformOrigin="0.5,0.5"  Grid.ColumnSpan="3">
                    <TextBox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TextBox.RenderTransform>
                </TextBox>

                <TextBlock
                       Text="Total Amount :"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="70,0,14,0" Grid.Column="2"/>

                <TextBox Grid.Column="2"
                     IsReadOnly="True"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Text="{Binding InvoiceTotal}" Margin="187,0,57,0" Grid.ColumnSpan="2"/>

                <Button Grid.Column="3"
                    Height="40"
                    Width="50"
                    Margin="31,0,0,0"
                    Content="Save"
                    Command="{Binding SaveCommand}"/>

            </Grid>

        </Border>

    </Grid>
</Window>
