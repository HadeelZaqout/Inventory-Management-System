<Window x:Class="Inventory_Managment_System.Views.ItemsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Inventory_Managment_System.Views"
        mc:Ignorable="d"
        Title="ItemsView" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <!-- First Column -->
            <ColumnDefinition Width="2*" />

            <!-- Second Column -->
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- ========================= -->
        <!-- LEFT SIDE : ITEMS LIST -->
        <!-- ========================= -->

        <Border Grid.Column="0"
                Margin="0,0,10,0"
                Padding="10"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel>

                <TextBlock Text="Available Items"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <ListView ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          Height="500">

                    <ListView.View>
                        <GridView>

                            <GridViewColumn Header="ID"
                                            Width="60"
                                            DisplayMemberBinding="{Binding ItemId}" />

                            <GridViewColumn Header="Name"
                                            Width="150"
                                            DisplayMemberBinding="{Binding Name}" />

                            <GridViewColumn Header="Price"
                                            Width="100"
                                            DisplayMemberBinding="{Binding Price}" />
                            <GridViewColumn Header="Stock"
                                            Width="100"
                                            DisplayMemberBinding="{Binding StockValue}" />       


                            <GridViewColumn Header="Unit"
                                            Width="100"
                                            DisplayMemberBinding="{Binding MeasuringUnit}" />

                        </GridView>

                    </ListView.View>

                </ListView>

            </StackPanel>

        </Border>

        <!-- ========================= -->
        <!-- RIGHT SIDE : FORM -->
        <!-- ========================= -->

        <Border Grid.Column="1"
                Padding="20"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="8">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="Add / Update Item"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,25"/>

                    <!-- Name -->
                    <TextBlock Text="Item Name"
                               FontWeight="SemiBold"/>
                    <TextBox Height="35"
                             Margin="0,5,0,15"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Details -->
                    <TextBlock Text="Details"
                               FontWeight="SemiBold"/>
                    <TextBox Height="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,5,0,15"
                             Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Price -->
                    <TextBlock Text="Price"
                               FontWeight="SemiBold"/>
                    <TextBox Height="35"
                             Margin="0,5,0,15"
                             Text="{Binding Price, UpdateSourceTrigger=LostFocus}"/>

                    <!-- Measuring Unit -->
                    <TextBlock Text="Measuring Unit"
                               FontWeight="SemiBold"/>
                    <TextBox Height="35"
                             Margin="0,5,0,15"
                             Text="{Binding MeasuringUnit, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- ReOrder Level -->
                    <TextBlock Text="ReOrder Level"
                               FontWeight="SemiBold"/>
                    <TextBox Height="35"
                             Margin="0,5,0,25"
                             Text="{Binding ReOrderLevel, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">

                        <Button Content="Save"
                                Width="120"
                                Height="40"
                                Margin="0,0,10,0"
                                Command="{Binding SaveCommand}"/>

                        <Button Content="Update"
                                Width="120"
                                Height="40"
                                Command="{Binding UpdateCommand}"/>

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>
