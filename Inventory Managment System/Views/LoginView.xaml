<Window x:Class="Inventory_Managment_System.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Inventory_Managment_System.Views"
        mc:Ignorable="d"
        Title="LoginView" Height="450" Width="800">
    <Grid>

        <Border Width="350"
                Padding="30"
                Background="White"
                CornerRadius="12"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <!-- Title -->
                <TextBlock Text="Welcome Back"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Login to your account"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- Username -->
                <TextBlock Text="Username"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox Height="38"
                         FontSize="14"
                         Padding="10,5"
                         Margin="0,0,0,20"
                         x:Name="UserNameBox"
                         Text="{Binding Username}"/>

                <!-- Password -->
                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <PasswordBox Height="38"
                             x:Name="PasswordBox"
                             FontSize="14"
                             Padding="10,5"
                             Margin="0,0,0,30"/>

                <!-- Login Button -->
                <Button Content="Login"
                        Click="Button_Click"
                        Height="42"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding LoginCommand}"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>
