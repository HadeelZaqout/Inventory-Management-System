<Window x:Class="Inventory_Managment_System.Views.AddSupplyView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Inventory_Managment_System.Views"
        mc:Ignorable="d"
        Title="Add New Supply" Height="450" Width="800">
    <Grid Margin="15">

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- ROW 01 : SUPPLIER -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                Padding="15"
                Margin="0,0,0,10"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Supplier"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <ComboBox Grid.Column="1"
                          Height="35"
                          FontSize="14"
                          ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier}"
                          IsEditable="True"
                          StaysOpenOnEdit="True"
                          IsTextSearchEnabled="True"
                          DisplayMemberPath="Name"/>
            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- ROW 02 : ITEM ENTRY -->
        <!-- ================================================= -->

        <Border Grid.Row="1"
                Padding="15"
                Margin="0,0,0,10"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Labels -->

                <TextBlock Text="Item"
                           FontWeight="SemiBold"
                           Margin="0,0,10,5"/>

                <TextBlock Grid.Column="1"
                           Text="Quantity"
                           FontWeight="SemiBold"
                           Margin="0,0,10,5"/>
                <TextBlock Grid.Column="1"
                           Width="50"
                           Text ="{Binding MeasuringUnitText}"
                           FontWeight="SemiBold"
                           Margin="0,0,10,5"/>      

                <TextBlock Grid.Column="2"
                           Text="Purchase Price"
                           FontWeight="SemiBold"
                           Margin="0,0,10,5"/>

                <!-- Controls -->

                <ComboBox Grid.Row="1"
                          Height="35"
                          Margin="0,0,10,0"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem , UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          StaysOpenOnEdit="True"
                          IsTextSearchEnabled="True"
                          DisplayMemberPath="Name"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Height="35"
                         Margin="0,0,10,0"
                         GotFocus="TextBox_GotFocus"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Quantity , UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Grid.Row="1"
                         Grid.Column="2"
                         Height="35"
                         Margin="0,0,10,0"
                         GotFocus="TextBox_GotFocus_1"
                         LostFocus="TextBox_LostFocus_1"
                         Text="{Binding PurchasePrice , UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Add Button -->

                <Button Grid.Row="1"
                        Grid.Column="3"
                        Width="100"
                        Height="35"
                        Content="Add Item"
                        Command="{Binding AddSupplyDetailCommand}"/>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- ROW 03 : DATAGRID -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Padding="10"
                Margin="0,0,0,10"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="8">

            <DataGrid ItemsSource="{Binding SupplyDetails}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      FontSize="14">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Item Name"
                                        Width="*"
                                        Binding="{Binding Item.Name}"/>

                    <DataGridTextColumn Header="Quantity"
                                        Width="150"
                                        Binding="{Binding Quantity}"/>

                    <DataGridTextColumn Header="Purchase Price"
                                        Width="150"
                                        Binding="{Binding PurchasePrice}"/>

                    

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- ================================================= -->
        <!-- ROW 04 : TOTAL + SAVE -->
        <!-- ================================================= -->

        <Border Grid.Row="3"
                Padding="15"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1"
                           Text="Total Supply Charges :"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBox Grid.Column="2"
                         Height="35"
                         IsReadOnly="True"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Text="{Binding TotalAmount}"/>

                <Button Grid.Column="3"
                        Width="120"
                        Height="40"
                        Margin="15,0,0,0"
                        Content="Save"
                        Command="{Binding SaveCommand}"/>

            </Grid>

        </Border>

    </Grid>

</Window>
