<Window x:Class="Inventory_Managment_System.Views.SuppliersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Inventory_Managment_System.Views"
        mc:Ignorable="d"
        Title="SuppliersView" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <!-- First Column -->
            <ColumnDefinition Width="2*" />

            <!-- Second Column -->
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- ========================= -->
        <!-- LEFT SIDE : ITEMS LIST -->
        <!-- ========================= -->

        <Border Grid.Column="0"
             Margin="0,0,10,0"
             Padding="10"
             BorderBrush="#D0D0D0"
             BorderThickness="1"
             CornerRadius="8">

            <StackPanel>

                <TextBlock Text="Available Suppliers"
                        FontSize="22"
                        FontWeight="Bold"
                        Margin="0,0,0,15"/>

                <ListView ItemsSource="{Binding Suppliers}"
                       SelectedItem="{Binding SelectedSupplier}"
                       Height="500">

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name"
                                         Width="150"
                                         DisplayMemberBinding="{Binding Name}" />

                            <GridViewColumn Header="Phone"
                                         Width="100"
                                         DisplayMemberBinding="{Binding Phone}" />

                            <GridViewColumn Header="Address"
                                         Width="100"
                                         DisplayMemberBinding="{Binding Address}" />

                        </GridView>

                    </ListView.View>

                </ListView>

            </StackPanel>

        </Border>

        <!-- ========================= -->
        <!-- RIGHT SIDE : FORM -->
        <!-- ========================= -->

        <Border Grid.Column="1"
             Padding="20"
             BorderBrush="#D0D0D0"
             BorderThickness="1"
             CornerRadius="8">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="Supplier Details"
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="0,0,0,25"/>

                    <!-- Name -->
                    <TextBlock Text="Supplier Name"
                            FontWeight="SemiBold"/>
                    <TextBox Height="35"
                          Margin="0,5,0,15"
                          Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Phone"
                        FontWeight="SemiBold"/>
                    <TextBox Height="35"
                      Margin="0,5,0,15"
                      Text="{Binding Phone, UpdateSourceTrigger=LostFocus}"/>


                    <!-- Details -->
                    <TextBlock Text="Address"
                            FontWeight="SemiBold"/>
                    <TextBox Height="80"
                          AcceptsReturn="True"
                          TextWrapping="Wrap"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,5,0,15"
                          Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Price -->
                    
                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal"
                             HorizontalAlignment="Left">

                        <Button Content="Save"
                             Width="120"
                             Height="40"
                             Margin="0,0,10,0"
                             Command="{Binding SaveCommand}"/>

                        <Button Content="Update"
                             Width="120"
                             Height="40"
                             Command="{Binding UpdateCommand}"/>

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>
</Window>
